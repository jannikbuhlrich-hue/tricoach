  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Einheit eintragen", "url": "./#log", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Kalender", "url": "./#calendar", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Fortschritt", "url": "./#progress", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Wettkampf", "url": "./#race", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
