  "description": "Triathlon-Training mit deiner Forerunner 265",
  "lang": "de",
  "start_url": "./",
  "scope": "./",
  "id": "./",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "orientation": "any",
  "background_color": "#0b0d12",
